<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             x:Class="MarketScanner.Views.WatchlistContentView">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:BoolToAccentColorConverter x:Key="BoolToAccentConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid x:Name="WatchlistRoot"
          RowDefinitions="Auto,*" 
          Padding="10"
          BackgroundColor="{StaticResource BackgroundDark}">

        <!-- Tab Bar -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*,Auto"
              Padding="0,0,0,10"
              BackgroundColor="{StaticResource SurfaceDark}"
              ColumnSpacing="10">
            
            <!-- Watchlist Tabs (Horizontal ScrollView) -->
            <ScrollView Grid.Column="0" 
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Always">
                <HorizontalStackLayout Spacing="2" Padding="5" BindableLayout.ItemsSource="{Binding Watchlists}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,6"
                                    Margin="2,0"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource BorderDark}"
                                    BackgroundColor="{StaticResource SurfaceVariantDark}">
                                
                                <HorizontalStackLayout Spacing="8">
                                    <!-- Tab Name -->
                                    <Label Text="{Binding Name}" 
                                           TextColor="{StaticResource OnSurfaceDark}"
                                           FontSize="13"
                                           VerticalOptions="Center"/>
                                    
                                    <!-- Close Button (×) -->
                                    <Button Text="×" 
                                            FontSize="16"
                                            Command="{Binding BindingContext.DeleteWatchlistCommand, Source={x:Reference WatchlistRoot}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnSurfaceDark}"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            Padding="0"
                                            Margin="0"/>
                                </HorizontalStackLayout>
                                
                                <!-- Tap to select tab -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding BindingContext.SelectWatchlistCommand, Source={x:Reference WatchlistRoot}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                
                                <!-- Right-click context menu (Rename - stubbed for now) -->
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Rename (Coming Soon)" 
                                                        Command="{Binding BindingContext.RenameWatchlistCommand, Source={x:Reference WatchlistRoot}}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="False"/>
                                        <MenuFlyoutItem Text="Delete" 
                                                        Command="{Binding BindingContext.DeleteWatchlistCommand, Source={x:Reference WatchlistRoot}}"
                                                        CommandParameter="{Binding .}"/>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            
            <!-- New Watchlist Button (+) -->
            <Button Grid.Column="1"
                    Text="+"
                    Command="{Binding CreateWatchlistCommand}"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    TextColor="{StaticResource TextOnAccent}"
                    FontSize="18"
                    FontAttributes="Bold"
                    WidthRequest="40"
                    HeightRequest="32"
                    Padding="0"
                    CornerRadius="4"/>
        </Grid>

        <!-- Watchlist Grid -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource BackgroundDark}">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="100,150,80,80,80,80,120,120"
                  BackgroundColor="{StaticResource SurfaceDark}"
                  HeightRequest="40"
                  Padding="5,0">

                <Label Grid.Column="0" Text="Symbol" Style="{StaticResource HeaderLabel}" HorizontalOptions="Start"/>
                <Label Grid.Column="1" Text="Company" Style="{StaticResource HeaderLabel}" HorizontalOptions="Start"/>
                <Label Grid.Column="2" Text="Change %" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="3" Text="Change" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="4" Text="Price" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="5" Text="Rel Vol" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="6" Text="Volume" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="7" Text="Avg Volume" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Data Rows -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding WatchlistItems}"
                            BackgroundColor="#1a1a1a"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="100,150,80,80,80,80,120,120"
                              BackgroundColor="#1a1a1a"
                              HeightRequest="32"
                              Padding="5,0">

                            <!-- Right-click context menu -->
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove from Watchlist"
                                                    Command="{Binding BindingContext.RemoveFromWatchlistCommand, Source={x:Reference WatchlistRoot}}"
                                                    CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>

                            <!-- Data cells -->
                            <Label Grid.Column="0" Text="{Binding Symbol}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   Padding="6,4"/>

                            <Label Grid.Column="1" Text="{Binding Company}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   LineBreakMode="TailTruncation"
                                   Padding="6,4"/>

                            <Label Grid.Column="2" 
                                   Text="{Binding ChangePercent, StringFormat='{0:+#0.00;-#0.00;0.00}%'}" 
                                   TextColor="{Binding ChangePercent, Converter={StaticResource ChangeToColorConverter}}"
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="3" 
                                   Text="{Binding Change, StringFormat='{0:+#0.00;-#0.00;0.00}'}" 
                                   TextColor="{Binding Change, Converter={StaticResource ChangeToColorConverter}}"
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="4" 
                                   Text="{Binding LastPrice, StringFormat='{0:C2}'}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="5" 
                                   Text="{Binding RelativeVolume, StringFormat='{0:0.0}x'}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="6" 
                                   Text="{Binding Volume, StringFormat='{0:N0}'}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="7" 
                                   Text="{Binding DisplayAvgVolume}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource PrimaryDark}"/>
                        <Label Text="No symbols in watchlist. Double-click rows in scanner to add."
                               IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Error Message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="{StaticResource ErrorColor}"
               VerticalOptions="End"
               HorizontalOptions="Center"
               Padding="10"
               BackgroundColor="{StaticResource SurfaceDark}"/>
    </Grid>
</ContentView>

